# =============================================================================
# Security Vulnerability Demo Lab - Git Ignore
# =============================================================================

# Dependencies
node_modules/
*/node_modules/

# Database files (regenerate with: npm run init-db)
*.db
*.sqlite
*.sqlite3

# Environment variables
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE / Editor files
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# Build output
dist/
build/
out/

# Temporary files
*.tmp
*.temp
.cache/

# Test coverage
coverage/
.nyc_output/

# =============================================================================
# NOTE: sensitive_config.txt is intentionally tracked!
# It contains FAKE credentials for the path traversal demo.
# In a real project, this would be in .gitignore!
# =============================================================================
